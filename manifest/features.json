{
  "version": 1,
  "features": {
    "log-analyzer": {
      "description": "Analyze logs, correlate errors with source, and redact common secrets.",
      "files": [
        {
          "source": ".github/skills/log-analyzer",
          "destination": ".github/skills/log-analyzer",
          "kind": "directory"
        }
      ]
    },
    "logging-advisor": {
      "description": "Suggest useful and safe logging locations, levels, and statements.",
      "files": [
        {
          "source": ".github/skills/logging-advisor",
          "destination": ".github/skills/logging-advisor",
          "kind": "directory"
        }
      ]
    },
    "occ-postman-generator": {
      "description": "Discover custom SAP Commerce OCC endpoints and generate Postman collections.",
      "files": [
        {
          "source": ".github/skills/occ-postman-generator",
          "destination": ".github/skills/occ-postman-generator",
          "kind": "directory"
        }
      ]
    },
    "worklog-generator": {
      "description": "Draft worklogs and commit messages from verified activity without inferring hours.",
      "files": [
        {
          "source": ".github/skills/worklog-generator",
          "destination": ".github/skills/worklog-generator",
          "kind": "directory"
        },
        {
          "source": ".github/agents/worklog-assistant.agent.md",
          "destination": ".github/agents/worklog-assistant.agent.md",
          "kind": "file"
        }
      ]
    },
    "code-review": {
      "description": "Local pre-PR review skill and read-only agent.",
      "files": [
        {
          "source": ".github/skills/code-review",
          "destination": ".github/skills/code-review",
          "kind": "directory"
        },
        {
          "source": ".github/agents/code-reviewer.agent.md",
          "destination": ".github/agents/code-reviewer.agent.md",
          "kind": "file"
        }
      ]
    },
    "security-checks": {
      "description": "Evidence-based security review with approval-gated scanner checks and redacted reports.",
      "files": [
        {
          "source": ".github/skills/security-checks",
          "destination": ".github/skills/security-checks",
          "kind": "directory"
        },
        {
          "source": ".github/agents/security-reviewer.agent.md",
          "destination": ".github/agents/security-reviewer.agent.md",
          "kind": "file"
        }
      ]
    }
  }
}
