{
  "name": "ai-dev-assistant",
  "version": "1.0.1",
  "description": "CLI installer for selected AI Dev Assistant features",
  "license": "UNLICENSED",
  "private": false,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ai-dev-assistant": "cli/index.js"
  },
  "files": [
    "cli/**",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AamenYousri/ai-dev-assistant.git"
  },
  "scripts": {
    "test": "node --test tests/node/*.test.js",
    "test:security": "python -m unittest discover -s tests -p \"test_*.py\"",
    "pack:check": "npm pack --dry-run",
    "package:cli": "npm pack"
  },
  "aiDevAssistant": {
    "repository": "AamenYousri/ai-dev-assistant",
    "ref": "v1.0.1"
  }
}